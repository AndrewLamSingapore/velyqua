{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "functions": { "api/trust.js": { "maxDuration": 30 } },
  "rewrites": [
    {
      "source": "/trust/v1/velyqua/:operation*",
      "destination": "/api/trust?operation=:operation*"
    },
    {
      "source": "/api/prime-events",
      "destination": "/api/prime?route=events"
    },
    {
      "source": "/api/prime-experiments",
      "destination": "/api/prime?route=experiments"
    }
  ]
}
