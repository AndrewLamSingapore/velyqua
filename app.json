{
  "expo": {
    "name": "VELYQUA",
    "slug": "velyqua",
    "version": "0.4.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "velyqua",
    "web": {
      "name": "VELYQUA",
      "shortName": "VELYQUA",
      "lang": "en",
      "themeColor": "#092f37",
      "backgroundColor": "#f3f7f5"
    },
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.andrewlamsingapore.velyqua",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.andrewlamsingapore.velyqua",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B2748"
      }
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F8F8"
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
